# Copy this file to .env in the same folder, then edit it.
# Environment variables override anything set here.

# Local OpenAI-compatible LLM server. Only the scheme, host and port are used;
# requests always go to /v1/chat/completions on that address.
# The host must be loopback: documents never leave the machine.
PRIVASHEET_BASE_URL=http://127.0.0.1:11434

# Model name. The built-in default is "local", which is a placeholder that
# matches nothing: set a model you have pulled, e.g. ollama pull qwen2.5:7b
PRIVASHEET_MODEL=qwen2.5:7b
